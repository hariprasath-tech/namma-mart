# LocalKart v3 Environment Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database Configuration
# In Docker / Production: postgresql://localkart:localkart_pass@postgres:5432/localkart_db
# For zero-config local dev without Docker: file:./dev.db
DATABASE_URL="file:./dev.db"

# Redis Configuration (BullMQ jobs & caching)
REDIS_URL="redis://localhost:6379"

# JWT Secrets (Random 32+ char strings)
JWT_SECRET="localkart_super_secret_jwt_key_pollachi_2026_tr3"
JWT_REFRESH_SECRET="localkart_super_secret_refresh_key_pollachi_2026_tr3"

# ML Microservice
ML_SERVICE_URL="http://localhost:8000/ml/v1"

# Reproducibility Seed
SEED="localkart_pollachi_v2"

# Security & Limits
RATE_LIMIT_MAX=100
MAX_UPLOAD_SIZE_MB=5
